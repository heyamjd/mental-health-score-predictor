# Environment variables for Mental Health Score Predictor
# Copy this file to .env and fill in values. Never commit .env to git.

# ── Backend ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins.
# Use specific URLs in production. DO NOT use * in production.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Rate limiting (slowapi format: "N/period" where period = second/minute/hour)
RATE_LIMIT=30/minute

# Path to trained model artifact (default is correct for repo layout)
# MODEL_PATH=models/pipeline.joblib
# METADATA_PATH=models/metadata.json

# ── Development ───────────────────────────────────────────────────────────────
DEBUG=false
